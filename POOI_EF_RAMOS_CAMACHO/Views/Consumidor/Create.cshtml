@model POOI_EF_RAMOS_CAMACHO.Models.Consumidor

@{
    ViewBag.Title = "Registrar Consumidor";
}

<h2>Registrar Consumidor</h2>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-info">
        @ViewBag.Mensaje
    </div>
}

@using (Html.BeginForm("Create", "Consumidor", FormMethod.Post))
{
    <div class="form-group">
        @Html.LabelFor(model => model.dnicont)

        @Html.TextBoxFor(
            model => model.dnicont,
            new
            {
                @class = "form-control",
                maxlength = "8",
                required = "required"
            }
        )
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.nomcont)

        @Html.TextBoxFor(
            model => model.nomcont,
            new
            {
                @class = "form-control",
                required = "required"
            }
        )
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.apecont)

        @Html.TextBoxFor(
            model => model.apecont,
            new
            {
                @class = "form-control",
                required = "required"
            }
        )
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.emailcont)

        @Html.TextBoxFor(
            model => model.emailcont,
            new
            {
                @class = "form-control",
                type = "email",
                required = "required"
            }
        )
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.idpais)

        @Html.DropDownListFor(
            model => model.idpais,
            (IEnumerable<SelectListItem>)ViewBag.Paises,
            "-- Seleccione país --",
            new { @class = "form-control" }
        )
    </div>

    <br />

    <button type="submit" class="btn btn-success">
        Registrar
    </button>

    @Html.ActionLink(
        "Regresar",
        "Index",
        "Consumidor",
        null,
        new { @class = "btn btn-default" }
    )
}