@model POOI_EF_RAMOS_CAMACHO.Models.Consumidor

@{
    ViewBag.Title = "Detalle del Consumidor";
}

<h2>Detalle del Consumidor</h2>

<table class="table table-bordered">
    <tr>
        <th>DNI</th>
        <td>@Model.dnicont</td>
    </tr>

    <tr>
        <th>Nombres</th>
        <td>@Model.nomcont</td>
    </tr>

    <tr>
        <th>Apellidos</th>
        <td>@Model.apecont</td>
    </tr>

    <tr>
        <th>Email</th>
        <td>@Model.emailcont</td>
    </tr>

    <tr>
        <th>País</th>
        <td>@Model.nombrepais</td>
    </tr>
</table>

@Html.ActionLink(
    "Editar",
    "Update",
    new { dni = Model.dnicont },
    new { @class = "btn btn-warning" }
)

@Html.ActionLink(
    "Regresar",
    "Index",
    null,
    new { @class = "btn btn-default" }
)